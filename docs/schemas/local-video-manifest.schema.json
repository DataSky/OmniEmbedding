{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omniembedding/local-video-manifest.schema.json",
  "title": "OmniEmbedding 本地原始视频清单 v1.0",
  "description": "每行一个已经成功落盘、校验并确认可解码的视频。Schema 仅检查结构；文件存在/大小/摘要、解码、来源身份哈希、元数据哈希和无凭证约束必须另外校验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source",
    "asset",
    "metadata",
    "metadata_sha256",
    "media",
    "extra"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "record_id": {
      "type": "string",
      "pattern": "^rec_[a-f0-9]{64}$(?![\\s\\S])",
      "description": "rec_ + sha256((source.system + NUL + source.id).encode(\"utf-8\")).hexdigest()。"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "id",
        "url",
        "created_at",
        "updated_at",
        "fetched_at"
      ],
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$(?![\\s\\S])",
          "description": "稳定的小写 ASCII 来源标识；不得随下载批次变化。"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[\\s\\u0000-\\u001f\\u007f-\\u009f]"
          },
          "description": "来源原始 ID，按字符串保留前导 0；禁止空白及控制字符。"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://[^\\s/@?#]+(?:/[^\\s?#]*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?$(?![\\s\\S])",
              "description": "无账号口令、凭证或下载签名的稳定定位 URL；敏感 query 仍须由语义检查拒绝。"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "fetched_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "downloaded_at",
        "original_filename",
        "mime_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^videos/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:mp4|mov|mkv|webm|avi|m4v|flv|ts)$(?![\\s\\S])",
          "description": "相对交付根目录的安全 POSIX 路径；仅允许 videos/ 下 ASCII 目录、文件名和小写视频扩展名。"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "downloaded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "original_filename": {
          "$ref": "#/$defs/nullable_string"
        },
        "mime_type": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "tags",
        "language",
        "published_at",
        "author_id",
        "author_name"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "language": {
          "$ref": "#/$defs/nullable_string"
        },
        "published_at": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "author_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "author_name": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "metadata_sha256": {
      "$ref": "#/$defs/sha256",
      "description": "sha256(json.dumps(metadata, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False).encode(\"utf-8\")).hexdigest()。"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_s",
        "width",
        "height",
        "fps",
        "codec",
        "has_audio"
      ],
      "properties": {
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "codec": {
          "$ref": "#/$defs/nullable_string"
        },
        "has_audio": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "已确认有/无音轨时分别为 true/false，未知必须为 null。"
        }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": true,
      "description": "JSON 业务扩展；不得包含凭证、下载签名 URL、Cookie 或访问密钥。"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$(?![\\s\\S])",
      "description": "RFC 3339 时间，必须包含 Z 或 ±HH:MM 时区。"
    },
    "nullable_timestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    }
  }
}
