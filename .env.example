# 复制为 .env 或直接设为环境变量。全部可选。

# 数据目录：数据库、视频、缩略图。视频多时请指到大容量盘
OMNI_DATA_DIR=./data

# 模型与设备（auto = 有 CUDA 用 GPU，否则 CPU）
OMNI_MODEL=google/embeddinggemma-2
# 固定权重提交；设为 main 跟随最新（换版本后已入库向量可能与新查询不一致）
OMNI_MODEL_REVISION=914f7f89142e33e77833254d9c9b90c3cef7303b
OMNI_DEVICE=auto

# 抽帧：每秒几帧、每条视频最多几帧
OMNI_FPS=1
OMNI_MAX_FRAMES=8

# 服务
OMNI_HOST=127.0.0.1
OMNI_PORT=8770
# 设置后所有写操作需要请求头 X-API-Key；监听非本机地址时必须设置
OMNI_API_KEY=

# 限制
OMNI_MAX_UPLOAD_MB=500
OMNI_URL_TIMEOUT=60
OMNI_MAX_BATCH=200
# 是否允许下载内网 / 回环地址的视频（默认拒绝，防 SSRF）
OMNI_ALLOW_PRIVATE_URLS=0

# /v1/embeddings 未指定 task 时的默认前缀（query / document / similarity / none …）
OMNI_EMBED_DEFAULT_TASK=query

# 健康检查（见 docs/HEALTH.md）：推理超时判 stalled、探测等锁上限、探测整体上限（秒）
OMNI_INFERENCE_TIMEOUT=120
OMNI_PROBE_WAIT=10
OMNI_PROBE_TIMEOUT=30

# 后台处理线程数（GPU 编码是瓶颈，一般 1 即可）
OMNI_WORKERS=1

# 国内下载模型可用镜像
# HF_ENDPOINT=https://hf-mirror.com
